DATABASE_URL="postgresql://user:password@localhost:5432/erp"
# Taille max du pool de connexions Postgres (defaut : 10)
DATABASE_POOL_MAX="10"
GEOAPIFY_API_KEY=""
# Inscription publique en self-service : "true" pour ouvrir /register apres
# l'installation initiale, sinon la page redirige vers /login.
ALLOW_PUBLIC_REGISTRATION="false"
# Domaine affiche a droite du sous-domaine a la creation d'une boutique
# (etape 2 de l'inscription).
APP_ROOT_DOMAIN="icomgest.cloud"
# URL publique de l'application, sans slash final. Sert a construire les liens
# envoyes par email (invitation, reinitialisation). OBLIGATOIRE en production :
# l'en-tete Host est fourni par le client, s'y fier permettrait d'empoisonner un
# lien de reinitialisation. En developpement, l'adresse est deduite du Host.
APP_BASE_URL="https://icomgest.cloud"
# Envoi des emails (code de verification a l'inscription). Sans RESEND_API_KEY,
# aucun email ne part : le code est ecrit dans la console du serveur et affiche
# dans l'interface hors production.
RESEND_API_KEY=""
MAIL_FROM="Icomgest <onboarding@resend.dev>"
# Upload d'images sur Cloudflare R2. Sans ces variables, les champs image
# retombent sur la saisie manuelle d'une URL. Voir docs/R2.md.
# NE JAMAIS mettre de vraies cles ici : ce fichier est versionne. Utiliser .env.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
