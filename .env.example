DATABASE_URL="postgresql://user:password@localhost:5432/erp"
# Taille max du pool de connexions Postgres (defaut : 10)
DATABASE_POOL_MAX="10"
GEOAPIFY_API_KEY=""
# Inscription publique en self-service : "true" pour ouvrir /register apres
# l'installation initiale, sinon la page redirige vers /login.
ALLOW_PUBLIC_REGISTRATION="false"
# Domaine affiche a droite du sous-domaine a la creation d'une boutique
# (etape 2 de l'inscription).
APP_ROOT_DOMAIN="icomgest.cloud"
# URL publique de l'application, sans slash final. Sert a construire les liens
# envoyes par email (invitation, reinitialisation). OBLIGATOIRE en production :
# l'en-tete Host est fourni par le client, s'y fier permettrait d'empoisonner un
# lien de reinitialisation. En developpement, l'adresse est deduite du Host.
APP_BASE_URL="https://icomgest.cloud"
# Envoi des emails (code de verification a l'inscription, invitations, reset de
# mot de passe). Renseigner UNE seule cle selon le fournisseur choisi. Sans aucune
# cle, aucun email ne part : le code est ecrit dans la console du serveur et
# affiche dans l'interface hors production.
#   - Resend : offre gratuite 3 000 emails/mois (100/jour). https://resend.com
#   - Brevo  : offre gratuite 300 emails/jour (~9 000/mois). https://www.brevo.com
# Resend est prioritaire si les deux cles sont presentes.
#
# BREVO : par defaut le compte bloque les envois depuis les IP non autorisees
# (erreur "Unauthorized IP address", cote API comme SMTP). Autoriser l'IP du
# serveur — ou desactiver la restriction — sur https://app.brevo.com/security/authorised_ips
RESEND_API_KEY=""
BREVO_API_KEY=""
# Expediteur. Le domaine doit etre verifie chez le fournisseur choisi pour
# pouvoir ecrire a n'importe quelle adresse (sinon Resend limite au domaine de
# test onboarding@resend.dev et a votre propre email).
MAIL_FROM="Icomgest <onboarding@resend.dev>"
# Upload d'images sur Cloudflare R2. Sans ces variables, les champs image
# retombent sur la saisie manuelle d'une URL. Voir docs/R2.md.
# NE JAMAIS mettre de vraies cles ici : ce fichier est versionne. Utiliser .env.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
